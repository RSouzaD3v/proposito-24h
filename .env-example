# =============================================================================
# DevotionalApp — variáveis de ambiente
# Copie para .env.local (dev) ou configure no provedor de deploy.
# =============================================================================

# --- App / NextAuth ----------------------------------------------------------
# URL pública da aplicação (sem barra no final)
BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Domínio base multi-tenant (subdomínios do escritor)
NEXT_PUBLIC_BASE_DOMAIN=localhost

# Fuso horário da app (quotes diários, etc.)
APP_TZ=America/Sao_Paulo

# --- PostgreSQL (Prisma) -----------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/devotionalapp?schema=public

# --- MongoDB (personalização / orações) --------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=railway

# --- Redis (filas / BullMQ) --------------------------------------------------
REDIS_URL=redis://default:password@localhost:6379

# --- AWS S3 (uploads) --------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# URL pública do bucket / CDN (sem barra no final)
S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# --- E-mail (MailerSend) -----------------------------------------------------
MAILERSEND_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=DevotionalApp
MAIL_REPLY_TO=contato@example.com

# --- Web Push (VAPID) --------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY deve ser a mesma chave pública do VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
WEB_PUSH_SUBJECT=mailto:contato@example.com

# --- Asaas (pagamentos) ------------------------------------------------------
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token enviado no header asaas-access-token do webhook
ASAAS_WEBHOOK_TOKEN=
# Domínio cadastrado no Asaas para redirect pós-pagamento (opcional)
ASAAS_CALLBACK_BASE_URL=https://example.com
# Assinatura do escritor (centavos). Default: 9990 = R$ 99,90
ASAAS_WRITER_SUBSCRIPTION_VALUE_CENTS=9990
# MONTHLY | WEEKLY | YEARLY | etc. (ciclo Asaas)
ASAAS_WRITER_SUBSCRIPTION_CYCLE=MONTHLY
ASAAS_WRITER_TRIAL_DAYS=7

# --- Google Gemini (IA) ------------------------------------------------------
GOOGLE_API_KEY=

# --- ElevenLabs (TTS) --------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Twilio WhatsApp (opcional) ----------------------------------------------
TWILIO_SID=
TWILIO_AUTH=

# --- Script: import da Bíblia (scripts/importBible.ts) -----------------------
# BIBLE_VERSION_CODE=NVI
# BIBLE_VERSION_NAME=Nova Versão Internacional
# BIBLE_VERSION_LANG=pt-BR
# IMPORT_CHUNK_SIZE=1000
