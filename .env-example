# Somente o necessário para o Next. Todo o restante fica em devotionalapp-nestjs/.env
# URL interna da API NestJS (precisa existir também durante o build)
API_URL=http://localhost:3333
# Mesmo valor de INTERNAL_API_KEY da API
INTERNAL_API_KEY=
# Mesmo valor de NEXTAUTH_SECRET da API
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_DOMAIN=localhost
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
